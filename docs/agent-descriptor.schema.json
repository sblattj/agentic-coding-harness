{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "description": {
      "type": "string"
    },
    "launch": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "template": {
              "type": "string",
              "minLength": 1
            },
            "promptVia": {
              "type": "string",
              "enum": [
                "argv",
                "stdin"
              ]
            },
            "shell": {
              "type": "boolean"
            },
            "output": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "const": "text"
                    }
                  },
                  "required": [
                    "format"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string",
                      "const": "jsonl"
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "input": {
                          "type": "string",
                          "minLength": 1
                        },
                        "output": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cacheRead": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cacheWrite": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reasoning": {
                          "type": "string",
                          "minLength": 1
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "costUsd": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "inputIncludesCache": {
                      "type": "boolean"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sessionId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "format"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "template"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "usageTap": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "transcript"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "const": "jsonl"
            },
            "fields": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "string",
                  "minLength": 1
                },
                "output": {
                  "type": "string",
                  "minLength": 1
                },
                "cacheRead": {
                  "type": "string",
                  "minLength": 1
                },
                "cacheWrite": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "costUsd": {
                  "type": "string",
                  "minLength": 1
                },
                "timestamp": {
                  "type": "string",
                  "minLength": 1
                },
                "sessionId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "inputIncludesCache": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "path",
            "format",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "pricingHints": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "input": {
            "type": "number",
            "minimum": 0
          },
          "output": {
            "type": "number",
            "minimum": 0
          },
          "cacheRead": {
            "type": "number",
            "minimum": 0
          },
          "cacheWrite": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "input",
          "output"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
