{
  "name": "agent-harness",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": {
    "agh": "./src/cli/harness.ts",
    "harness": "./src/cli/harness.ts"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts src/adapters/*.test.ts",
    "test:bun": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "bun build src/cli/harness.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "bun-types": "^1.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0"
  }
}
