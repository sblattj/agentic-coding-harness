{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "model": "ferry/heavy"
    },
    "plan": {
      "model": "ferry/heavy"
    },
    "general": {
      "model": "ferry/medium"
    },
    "explore": {
      "model": "ferry/flash"
    },
    "compaction": {
      "model": "ferry/super-flash"
    },
    "title": {
      "model": "ferry/super-flash"
    },
    "summary": {
      "model": "ferry/super-flash"
    }
  },
  "compaction": {
    "auto": true,
    "reserved": 8000
  },
  "default_agent": "build",
  "instructions": [
    "/Users/sblatt/.config/opencode/AGENTS.md"
  ],
  "mcp": {
    "agentic-password-injector": {
      "command": [
        "/Users/sblatt/.bun/bin/bun",
        "/Users/sblatt/.dotai/vendor/agentic-password-injector/src/mcp.ts"
      ],
      "enabled": true,
      "environment": {
        "CDP_BASE": "http://127.0.0.1:9333"
      },
      "timeout": 20000,
      "type": "local"
    },
    "basic-memory": {
      "command": [
        "/Users/sblatt/.local/bin/basic-memory",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "BASIC_MEMORY_NO_PROMOS": "1"
      },
      "type": "local"
    },
    "cdp-toolkit": {
      "command": [
        "/Users/sblatt/.bun/bin/bun",
        "/Users/sblatt/.dotai/vendor/cdp-toolkit/src/mcp.ts"
      ],
      "enabled": true,
      "environment": {
        "CDP_BASE": "http://127.0.0.1:9333"
      },
      "timeout": 20000,
      "type": "local"
    },
    "codebase-memory-mcp": {
      "command": [
        "/Users/sblatt/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true,
      "environment": {},
      "timeout": 30000,
      "type": "local"
    },
    "google-workspace": {
      "command": [
        "/Users/sblatt/.local/bin/workspace-mcp",
        "--single-user",
        "--tools",
        "appscript",
        "calendar",
        "chat",
        "contacts",
        "docs",
        "drive",
        "forms",
        "gmail",
        "search",
        "sheets",
        "slides",
        "tasks"
      ],
      "enabled": true,
      "environment": {
        "GOOGLE_CLIENT_SECRET_PATH": "/Users/sblatt/.config/google-workspace-mcp/client_secret.json",
        "OAUTHLIB_INSECURE_TRANSPORT": "1",
        "USER_GOOGLE_EMAIL": "stephenjblatt@gmail.com",
        "WORKSPACE_MCP_TOOL_PROFILE": "core"
      },
      "timeout": 30000,
      "type": "local"
    }
  },
  "model": "ferry/heavy",
  "permission": "allow",
  "plugin": [
    "opencode-goal-plugin"
  ],
  "provider": {
    "ferry": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ferry (127.0.0.1)",
      "options": {
        "apiKey": "local",
        "baseURL": "http://127.0.0.1:8090/v1",
        "headers": {
          "X-Ferry-Client": "host",
          "X-Ferry-Fleet": "{env:FERRY_FLEET}"
        }
      },
      "models": {
        "heavy": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "heavy"
        },
        "medium": {},
        "flash": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "flash"
        },
        "super-flash": {
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "name": "super-flash"
        },
        "local-orch": {
          "name": "local-orch"
        },
        "local-sub": {
          "name": "local-sub"
        }
      }
    }
  },
  "small_model": "ferry/super-flash"
}
