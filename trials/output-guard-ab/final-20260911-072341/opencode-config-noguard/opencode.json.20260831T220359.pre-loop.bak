{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ferry": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ferry (127.0.0.1)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "heavy": {},
        "flash": {},
        "super-flash": {}
      }
    }
  },
  "permission": "allow",
  "model": "ferry/heavy",
  "small_model": "ferry/super-flash",
  "agent": {
    "build": {
      "model": "ferry/heavy"
    },
    "plan": {
      "model": "ferry/heavy"
    },
    "general": {
      "model": "ferry/flash"
    },
    "explore": {
      "model": "ferry/flash"
    },
    "title": {
      "model": "ferry/super-flash"
    },
    "summary": {
      "model": "ferry/super-flash"
    },
    "compaction": {
      "model": "ferry/super-flash"
    }
  },
  "mcp": {
    "basic-memory": {
      "type": "local",
      "command": ["/Users/sblatt/.local/bin/basic-memory", "mcp"],
      "enabled": true,
      "environment": {
        "BASIC_MEMORY_NO_PROMOS": "1"
      }
    }
  },
  "plugin": [
    "/Users/sblatt/code/opencode-goal-plugin/dist/server.js"
  ]
}
