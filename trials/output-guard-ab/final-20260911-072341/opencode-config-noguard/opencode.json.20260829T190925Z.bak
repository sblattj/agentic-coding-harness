{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ferry": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ferry (127.0.0.1)",
      "options": {
        "baseURL": "http://127.0.0.1:8090/v1",
        "apiKey": "local"
      },
      "models": {
        "orch": {},
        "flash": {},
        "super-flash": {}
      }
    }
  },
  "permission": "allow",
  "model": "ferry/orch",
  "small_model": "ferry/super-flash",
  "agent": {
    "build": {
      "model": "ferry/orch"
    },
    "plan": {
      "model": "ferry/orch"
    },
    "general": {
      "model": "ferry/flash"
    },
    "explore": {
      "model": "ferry/flash"
    },
    "title": {
      "model": "ferry/super-flash"
    },
    "summary": {
      "model": "ferry/super-flash"
    },
    "compaction": {
      "model": "ferry/super-flash"
    }
  },
  "plugin": [
    "/Users/sblatt/code/opencode-goal-plugin/dist/server.js"
  ]
}
