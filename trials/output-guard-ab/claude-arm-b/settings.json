{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "1000000",
    "OUTPUT_GUARD": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/projects/agent-harness/trials/output-guard-ab/claude-arm-b/hooks/output-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
